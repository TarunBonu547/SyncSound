{
  "name": "syncsound",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node tests/room.test.js && node tests/chat.test.js && node tests/queue.test.js && node tests/display-name.test.js && node tests/youtube-search.test.js && node tests/youtube-search-client.test.js && npm run test:render",
    "test:room": "node tests/room.test.js",
    "test:chat": "node tests/chat.test.js",
    "test:queue": "node tests/queue.test.js",
    "test:display-name": "node tests/display-name.test.js",
    "test:search": "node tests/youtube-search.test.js && node tests/youtube-search-client.test.js",
    "test:render": "vite build --ssr tests/render-entry.tsx --outDir .render-check --emptyOutDir --logLevel warn && node tests/render.test.js"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  }
}
