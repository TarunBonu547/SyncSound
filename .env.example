# Frontend environment for SyncSound.
#
# Copy this file to `.env` (or `.env.local`) and fill in your own values.
# `.env*` files are ignored by git, so credentials never reach the repository.

# Where the Socket.IO backend lives.
VITE_SOCKET_URL=http://localhost:4000

# Where the REST API of the backend lives. It is the socket server by default.
# VITE_API_URL=http://localhost:4000

# --- YouTube search ----------------------------------------------------------
#
# The key of the YouTube Data API v3. It belongs to the BACKEND and is only
# read from the environment of the backend process - never from a `VITE_`
# variable, because everything a `VITE_` variable holds is sent to the
# browser. Without a key the search answers "not configured"; the queue and
# the playback keep working.
#
# YOUTUBE_API_KEY=your-key-here

# The YouTube API needs the key of a project with the "YouTube Data API v3"
# enabled:
#   1. open https://console.cloud.google.com/apis/library
#   2. pick (or create) a project
#   3. search for "YouTube Data API v3" and enable it
#   4. open "Credentials" and create an API key
#
# A search spends 100 units of the daily quota, the default quota is 10.000
# units a day, so a hundred searches are possible.
#
# How long a search answer is kept in the memory of the backend, so the same
# search does not spend the quota twice. `0` turns the cache off.
# YOUTUBE_SEARCH_CACHE_MS=60000

# The address of the YouTube API. It is only meant for tests, where a local
# stub replaces YouTube. A client can never aim the server somewhere else.
# YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3

# --- Video call (WebRTC) ----------------------------------------------------
#
# The ICE servers the browser uses to find a path to the other person.
# Public STUN servers are used automatically when nothing is configured here.
#
# Preferred: a full JSON list.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]
#
# Alternative: a single TURN server.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=user
# VITE_TURN_CREDENTIAL=secret
#
# TURN credentials are visible to anyone who opens the page. Use short lived
# credentials (for example from coturn with a REST API shared secret) and
# rotate them often. A TURN server is required for calls that have to work
# across symmetric NATs and strict corporate firewalls.
#
# Production calls also need HTTPS: browsers only allow the camera and the
# microphone on a secure origin (localhost is treated as secure).
